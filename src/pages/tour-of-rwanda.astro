---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE } from "../consts";
import { Image } from "astro:assets";
import {
	nineDayItineraryItems,
	tourTitle,
	totalDuration,
	tourHighlights,
} from "../content/nine-day-itinerary";
import adiTouring from "../assets/adi-touring.png";
import PhotoGallery from "../components/PhotoGallery.astro";

// Rwanda tour photos from the gallery - all images including bed images in random order
const rwandaPhotos = [
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/lakes.jpeg",
		alt: "Beautiful Twin Lakes landscape",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/lakes-2.jpeg",
		alt: "Twin Lakes from different angle",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/landscape.jpeg",
		alt: "Rwanda countryside landscape",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/landscape-2.jpeg",
		alt: "Scenic Rwanda landscape",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/sunset.jpeg",
		alt: "Beautiful sunset over Rwanda",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/tour.jpeg",
		alt: "Tour group experience",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/house.jpeg",
		alt: "Traditional Rwandan house",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/hut.jpeg",
		alt: "Traditional hut",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/garden.jpeg",
		alt: "Beautiful garden",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/garden-2.jpeg",
		alt: "Garden landscape",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/dance.jpeg",
		alt: "Traditional dance performance",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/scenic.jpeg",
		alt: "Scenic Rwanda view",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/picnic.jpeg",
		alt: "Picnic experience",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/table.jpeg",
		alt: "Dining setup",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/balcony.jpeg",
		alt: "Balcony with view",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/bed.jpeg",
		alt: "Comfortable accommodations",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/bed-2.jpeg",
		alt: "Bedroom setup",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/bed-3.jpeg",
		alt: "Room interior",
	},
	{
		src: "/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/bed-4.jpeg",
		alt: "Sleeping arrangements",
	},
].sort(() => Math.random() - 0.5);
---

<Layout
	title={`${tourTitle} - ${SITE_TITLE}`}
	description="Experience Rwanda's complete adventure with our comprehensive 9-day tour covering Akagera National Park, Nyungwe National Park, Lake Kivu, and Volcanoes National Park."
>
	<!-- Hero Section -->
	<div class="z-10 relative mx-auto mt-16 md:mt-24 container">
		<div class="mb-8 text-center">
			<a
				href="/rwanda-twin-lakes-boat-tour/"
				class="inline-flex items-center gap-2 mb-6 text-gray-600 hover:text-emerald-700 transition"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					class="w-5 h-5"
					viewBox="0 0 20 20"
					fill="currentColor"
				>
					<path
						fill-rule="evenodd"
						d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z"
						clip-rule="evenodd"></path>
				</svg>
				Back to Home
			</a>
			<h1 class="mb-4 font-bold text-gray-700 text-4xl leading-tight">
				{tourTitle}
			</h1>
			<p class="mx-auto max-w-2xl text-gray-700 text-lg">
				Experience the complete beauty of Rwanda with our comprehensive
				tour covering all major national parks and cultural sites.
			</p>
		</div>

		<div class="shadow-xl mb-8 rounded-xl overflow-hidden">
			<img
				src="/rwanda-twin-lakes-boat-tour/rwanda-tour-photos/scenic.jpeg"
				alt="Scenic Rwanda landscape"
				class="w-full h-96 object-cover"
				loading="eager"
			/>
		</div>

		<!-- Tour Info Cards -->
		<div
			class="gap-6 grid grid-cols-1 md:grid-cols-3 bg-white/50 shadow-lg backdrop-blur-md p-6 border border-amber-200 rounded-xl"
		>
			<div class="flex items-center gap-4">
				<div
					class="bg-blue-200 shadow-inner p-3 rounded-full text-blue-700"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="w-6 h-6"
						viewBox="0 0 20 20"
						fill="currentColor"
					>
						<path
							fill-rule="evenodd"
							d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
							clip-rule="evenodd"></path>
					</svg>
				</div>
				<div>
					<p class="font-medium text-gray-800">
						{totalDuration}
					</p>
					<p class="text-gray-600 text-sm">
						Complete Rwanda Experience
					</p>
				</div>
			</div>

			<div class="flex items-center gap-4">
				<div
					class="bg-emerald-200 shadow-inner p-3 rounded-full text-emerald-700"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="w-6 h-6"
						viewBox="0 0 20 20"
						fill="currentColor"
					>
						<path
							fill-rule="evenodd"
							d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
							clip-rule="evenodd"></path>
					</svg>
				</div>
				<div>
					<p class="font-medium text-gray-800">4 National Parks</p>
					<p class="text-gray-600 text-sm">
						Akagera, Nyungwe, Volcanoes, Twin Lakes
					</p>
				</div>
			</div>

			<div class="flex items-center gap-4">
				<div
					class="bg-amber-200 shadow-inner p-3 rounded-full text-amber-700"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="w-6 h-6"
						viewBox="0 0 20 20"
						fill="currentColor"
					>
						<path
							d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"
						></path>
					</svg>
				</div>
				<div>
					<p class="font-medium text-gray-800">Expert Guidance</p>
					<p class="text-gray-600 text-sm">
						Professional local guides
					</p>
				</div>
			</div>
		</div>
	</div>

	<!-- Tour Highlights Section -->
	<section class="mt-16">
		<h2 class="mb-8 text-3xl section-title">Tour Highlights</h2>
		<div class="gap-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
			{
				tourHighlights.map((highlight) => (
					<div class="flex items-center gap-3 bg-emerald-50/50 p-4 border border-emerald-200 rounded-lg">
						<div class="bg-emerald-500 rounded-full w-2 h-2" />
						<span class="text-gray-700">{highlight}</span>
					</div>
				))
			}
		</div>
	</section>

	<!-- Day-by-Day Itinerary Section -->
	<section class="mt-16">
		<h2 class="mb-8 text-3xl section-title">Day-by-Day Itinerary</h2>

		<div class="space-y-8">
			{
				nineDayItineraryItems.map((item) => (
					<div class="bg-white/70 shadow-lg backdrop-blur-sm p-6 border border-gray-200 rounded-xl">
						<div class="flex justify-between items-start mb-4">
							<div>
								<div class="flex items-center gap-3 mb-2">
									<div class="flex justify-center items-center bg-emerald-600 rounded-full w-8 h-8 font-bold text-white">
										{item.day}
									</div>
									<h3 class="font-semibold text-gray-800 text-xl">
										{item.title}
									</h3>
								</div>
								<p class="mb-3 font-medium text-emerald-600">
									{item.mainDestination}
								</p>
							</div>
						</div>

						<p class="mb-4 text-gray-700">{item.description}</p>

						<div class="space-y-2">
							<h4 class="font-medium text-gray-800">
								Key Activities:
							</h4>
							<ul class="gap-2 grid grid-cols-1 md:grid-cols-2">
								{item.activities.map((activity) => (
									<li class="flex items-center gap-2 text-gray-600 text-sm">
										<div class="bg-emerald-400 rounded-full w-1.5 h-1.5" />
										{activity}
									</li>
								))}
							</ul>
						</div>
					</div>
				))
			}
		</div>
	</section>

	<!-- Photo Gallery Section -->
	<PhotoGallery photos={rwandaPhotos} title="Rwanda Experience Gallery" />

	<!-- Booking Section -->
	<section class="mt-16">
		<h2 class="mb-8 text-3xl section-title">Book Your 9-Day Adventure</h2>

		<div class="flex md:flex-row flex-col items-center gap-10">
			<div class="rounded-lg w-full md:w-1/2 overflow-hidden">
				<Image
					src={adiTouring}
					alt="Rwanda tour guide"
					class="w-full h-auto object-cover"
					width={500}
					height={300}
					style="aspect-ratio: 5/3;"
				/>
			</div>

			<div class="space-y-6 w-full md:w-1/2">
				<p class="text-gray-700 text-lg">
					Ready for the ultimate Rwanda adventure? This comprehensive
					9-day tour covers all of Rwanda's major attractions and
					provides an unforgettable cultural and wildlife experience.
				</p>

				<a
					href="https://wa.me/250726606622?text=Hello%20Abiathar,%20I'm%20interested%20in%20booking%20the%209-day%20Rwanda%20tour%20covering%20Akagera,%20Nyungwe,%20Lake%20Kivu,%20and%20Volcanoes%20National%20Parks.%20Please%20provide%20more%20information."
					target="_blank"
					class="inline-block whatsapp-button"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						class="w-6 h-6"
						viewBox="0 0 24 24"
						fill="currentColor"
					>
						<path
							d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
						></path>
					</svg>
					<span>Book 9-Day Tour (250 726 606 622)</span>
				</a>

				<p class="mt-2 text-gray-600 text-sm">
					Contact us for customized itineraries and group bookings
				</p>
			</div>
		</div>
	</section>
</Layout>
