---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE } from "../consts";
import { Image } from "astro:assets";
import { nineDayItineraryItems, tourTitle, totalDuration, tourHighlights } from "../content/nine-day-itinerary";
import location from "../assets/location.png";
import adiTouring from "../assets/adi-touring.png";
import PhotoGallery from "../components/PhotoGallery.astro";

// Rwanda tour photos from the gallery
const rwandaPhotos = [
  { src: "/rwanda-tour-photos/lakes.jpeg", alt: "Beautiful Twin Lakes landscape", title: "Twin Lakes Views" },
  { src: "/rwanda-tour-photos/lakes-2.jpeg", alt: "Twin Lakes from different angle", title: "Lake Panorama" },
  { src: "/rwanda-tour-photos/landscape.jpeg", alt: "Rwanda countryside landscape", title: "Rolling Hills" },
  { src: "/rwanda-tour-photos/landscape-2.jpeg", alt: "Scenic Rwanda landscape", title: "Mountain Views" },
  { src: "/rwanda-tour-photos/sunset.jpeg", alt: "Beautiful sunset over Rwanda", title: "Rwanda Sunset" },
  { src: "/rwanda-tour-photos/tour.jpeg", alt: "Tour group experience", title: "Tour Experience" },
  { src: "/rwanda-tour-photos/house.jpeg", alt: "Traditional Rwandan house", title: "Local Architecture" },
  { src: "/rwanda-tour-photos/hut.jpeg", alt: "Traditional hut", title: "Cultural Heritage" },
  { src: "/rwanda-tour-photos/garden.jpeg", alt: "Beautiful garden", title: "Local Gardens" },
  { src: "/rwanda-tour-photos/garden-2.jpeg", alt: "Garden landscape", title: "Garden Views" },
  { src: "/rwanda-tour-photos/dance.jpeg", alt: "Traditional dance performance", title: "Cultural Dance" },
  { src: "/rwanda-tour-photos/scenic.jpeg", alt: "Scenic Rwanda view", title: "Scenic Beauty" },
  { src: "/rwanda-tour-photos/picnic.jpeg", alt: "Picnic experience", title: "Outdoor Dining" },
  { src: "/rwanda-tour-photos/table.jpeg", alt: "Dining setup", title: "Local Meals" },
  { src: "/rwanda-tour-photos/balcony.jpeg", alt: "Balcony with view", title: "Accommodation Views" },
  { src: "/rwanda-tour-photos/bed.jpeg", alt: "Comfortable accommodations", title: "Rest & Comfort" },
  { src: "/rwanda-tour-photos/bed-2.jpeg", alt: "Bedroom setup", title: "Cozy Lodging" },
  { src: "/rwanda-tour-photos/bed-3.jpeg", alt: "Room interior", title: "Quality Accommodation" },
  { src: "/rwanda-tour-photos/bed-4.jpeg", alt: "Sleeping arrangements", title: "Comfortable Stay" }
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${tourTitle} - ${SITE_TITLE}`} description="Experience Rwanda's complete adventure with our comprehensive 9-day tour covering Akagera National Park, Nyungwe National Park, Lake Kivu, and Volcanoes National Park." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, maximum-scale=1"
		/>
		<style>
			:root {
				--accent: #10b981;
				--accent-dark: #065f46;
				--primary: #059669;
				--secondary: #34d399;
				--tertiary: #047857;
				--bg-color: #f8fafc;
			}
			body {
				background-color: var(--bg-color);
				background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%2310b981' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
			}
			.section-title {
				color: var(--accent-dark);
				position: relative;
				display: inline-block;
				margin-bottom: 1.5rem;
				font-family: 'Baloo 2', cursive;
			}
			.section-title::after {
				content: "";
				position: absolute;
				bottom: -0.5rem;
				left: 0;
				width: 100%;
				height: 0.25rem;
				background-color: var(--accent);
				border-radius: 9999px;
				opacity: 0.3;
			}
			.whatsapp-button {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				background-color: #20be5a;
				color: white;
				padding: 0.75rem 1.5rem;
				border-radius: 2rem;
				font-weight: 500;
				transition: all 0.2s;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
			}
			.whatsapp-button:hover {
				background-color: #128C7E;
				transform: translateY(-2px);
				box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
			}
		</style>
	</head>
	<body class="relative mx-auto mt-0 md:px-8 overflow-x-hidden">
		<div class="z-0 absolute inset-0 bg-gradient-to-br from-amber-100/80 via-sky-50 to-amber-50"></div>

		<main class="relative space-y-16 mx-auto mt-0 px-4 md:px-8 max-w-[1000px] overflow-hidden">
			<!-- Hero Section -->
			<div class="z-10 relative mx-auto mt-16 md:mt-24 container">
				<div class="text-center mb-8">
					<a href="/" class="inline-flex items-center gap-2 mb-6 text-gray-600 hover:text-emerald-700 transition">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
						</svg>
						Back to Home
					</a>
					<h1 class="mb-4 font-bold text-gray-700 text-4xl leading-tight">
						{tourTitle}
					</h1>
					<p class="max-w-2xl mx-auto text-gray-700 text-lg">
						Experience the complete beauty of Rwanda with our comprehensive tour covering all major national parks and cultural sites.
					</p>
				</div>

				<div class="shadow-xl rounded-xl overflow-hidden mb-8">
					<Image
						src={location}
						alt="Rwanda landscape"
						class="w-full h-96 object-cover"
						width={1000}
						height={400}
						loading="eager"
						decoding="async"
						format="avif"
						quality={80}
					/>
				</div>

				<!-- Tour Info Cards -->
				<div class="gap-6 grid grid-cols-1 md:grid-cols-3 bg-white/50 shadow-lg backdrop-blur-md p-6 border border-amber-200 rounded-xl">
					<div class="flex items-center gap-4">
						<div class="bg-blue-200 shadow-inner p-3 rounded-full text-blue-700">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
							</svg>
						</div>
						<div>
							<p class="font-medium text-gray-800">{totalDuration}</p>
							<p class="text-gray-600 text-sm">Complete Rwanda Experience</p>
						</div>
					</div>
					
					<div class="flex items-center gap-4">
						<div class="bg-emerald-200 shadow-inner p-3 rounded-full text-emerald-700">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
							</svg>
						</div>
						<div>
							<p class="font-medium text-gray-800">4 National Parks</p>
							<p class="text-gray-600 text-sm">Akagera, Nyungwe, Volcanoes, Twin Lakes</p>
						</div>
					</div>
					
					<div class="flex items-center gap-4">
						<div class="bg-amber-200 shadow-inner p-3 rounded-full text-amber-700">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 20 20" fill="currentColor">
								<path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z" />
							</svg>
						</div>
						<div>
							<p class="font-medium text-gray-800">Expert Guidance</p>
							<p class="text-gray-600 text-sm">Professional local guides</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Tour Highlights Section -->
			<section class="mt-16">
				<h2 class="mb-8 text-3xl section-title">Tour Highlights</h2>
				<div class="gap-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
					{tourHighlights.map((highlight) => (
						<div class="flex items-center gap-3 bg-emerald-50/50 p-4 border border-emerald-200 rounded-lg">
							<div class="bg-emerald-500 rounded-full w-2 h-2"></div>
							<span class="text-gray-700">{highlight}</span>
						</div>
					))}
				</div>
			</section>

			<!-- Day-by-Day Itinerary Section -->
			<section class="mt-16">
				<h2 class="mb-8 text-3xl section-title">Day-by-Day Itinerary</h2>
				
				<div class="space-y-8">
					{nineDayItineraryItems.map((item) => (
						<div class="bg-white/70 shadow-lg backdrop-blur-sm p-6 border border-gray-200 rounded-xl">
							<div class="flex md:flex-row flex-col gap-6">
								<div class="w-full md:w-1/3">
									<div class="rounded-lg overflow-hidden" style="aspect-ratio: 4/3;">
										<Image
											src={item.image}
											alt={item.imageAlt}
											class="w-full h-full object-cover"
											width={400}
											height={300}
											loading="lazy"
											decoding="async"
											format="avif"
											quality={80}
										/>
									</div>
								</div>
								
								<div class="w-full md:w-2/3">
									<div class="flex items-start justify-between mb-4">
										<div>
											<div class="flex items-center gap-3 mb-2">
												<div class="flex justify-center items-center bg-emerald-600 rounded-full w-8 h-8 text-white font-bold">
													{item.day}
												</div>
												<h3 class="font-semibold text-xl text-gray-800">{item.title}</h3>
											</div>
											<p class="text-emerald-600 font-medium mb-3">{item.mainDestination}</p>
										</div>
									</div>
									
									<p class="mb-4 text-gray-700">{item.description}</p>
									
									<div class="space-y-2">
										<h4 class="font-medium text-gray-800">Key Activities:</h4>
										<ul class="gap-2 grid grid-cols-1 md:grid-cols-2">
											{item.activities.map((activity) => (
												<li class="flex items-center gap-2 text-gray-600 text-sm">
													<div class="bg-emerald-400 rounded-full w-1.5 h-1.5"></div>
													{activity}
												</li>
											))}
										</ul>
									</div>
								</div>
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- Photo Gallery Section -->
			<PhotoGallery photos={rwandaPhotos} title="Rwanda Experience Gallery" />

			<!-- Booking Section -->
			<section class="mt-16">
				<h2 class="mb-8 text-3xl section-title">Book Your 9-Day Adventure</h2>
				
				<div class="flex md:flex-row flex-col items-center gap-10">
					<div class="rounded-lg w-full md:w-1/2 overflow-hidden">
						<Image
							src={adiTouring}
							alt="Rwanda tour guide"
							class="w-full h-auto object-cover"
							width={500}
							height={300}
							style="aspect-ratio: 5/3;"
						/>
					</div>

					<div class="space-y-6 w-full md:w-1/2">
						<p class="text-gray-700 text-lg">
							Ready for the ultimate Rwanda adventure? This comprehensive 9-day tour 
							covers all of Rwanda's major attractions and provides an unforgettable 
							cultural and wildlife experience.
						</p>
						
						<div class="bg-emerald-50/50 p-4 border border-emerald-200 rounded-lg">
							<h4 class="font-medium text-emerald-800 mb-2">What's Included:</h4>
							<ul class="space-y-1 text-emerald-700 text-sm">
								<li>• Professional local guides</li>
								<li>• All park entrance fees</li>
								<li>• Accommodation for 8 nights</li>
								<li>• Transportation throughout</li>
								<li>• Most meals included</li>
								<li>• Cultural experiences</li>
							</ul>
						</div>
						
						<a
							href="https://wa.me/250726606622?text=Hello%20Abiathar,%20I'm%20interested%20in%20booking%20the%209-day%20Rwanda%20tour%20covering%20Akagera,%20Nyungwe,%20Lake%20Kivu,%20and%20Volcanoes%20National%20Parks.%20Please%20provide%20more%20information."
							target="_blank"
							class="inline-block whatsapp-button"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								class="w-6 h-6"
								viewBox="0 0 24 24"
								fill="currentColor"
							>
								<path
									d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
								></path>
							</svg>
							<span>Book 9-Day Tour</span>
						</a>
						
						<p class="mt-2 text-gray-600 text-sm">
							Contact us for customized itineraries and group bookings
						</p>
					</div>
				</div>
			</section>

			<Footer />
		</main>
	</body>
</html>